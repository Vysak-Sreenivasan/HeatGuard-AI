# .env.example — HeatGuard AI environment variables
#
# Copy to .env and fill in the real values.
# NEVER commit .env to version control.
# All secrets go here; never hardcode in source files (rules.md §7).

# ---------------------------------------------------------------------------
# MCP Device Gateway
# ---------------------------------------------------------------------------

# Bearer token for authenticating to the Device Gateway MCP server.
# Must match the MCP_AUTH_TOKEN set in the mcp-server container.
MCP_AUTH_TOKEN=change-me-mcp-auth-token

# URL of the Device Gateway MCP server (Streamable HTTP transport).
# Default inside Docker: http://mcp-server:8001/mcp
# For local dev without Docker: http://localhost:8001/mcp
MCP_SERVER_URL=http://mcp-server:8001/mcp

# ---------------------------------------------------------------------------
# Approval signing (HMAC-SHA256)
# ---------------------------------------------------------------------------

# Shared secret used by this app (backend) to sign approval tokens and by
# the MCP server to verify them. MUST be identical on both sides.
# Use at least 32 random bytes: openssl rand -hex 32
APPROVAL_SIGNING_SECRET=change-me-approval-signing-secret-min-32-chars

# ---------------------------------------------------------------------------
# PostgreSQL (LangGraph checkpointer + device registry + audit log)
# ---------------------------------------------------------------------------

POSTGRES_PASSWORD=change-me-postgres-password
# Connection string for the backend service (inside Docker Compose network).
DATABASE_URL=postgresql://postgres:change-me-postgres-password@postgres:5432/heatguard

# ---------------------------------------------------------------------------
# LLM provider (switch with no code change)
# ---------------------------------------------------------------------------

# Options: ollama | openai | anthropic
LLM_PROVIDER=ollama

# --- Ollama (default, runs on host) ----------------------------------------
# Reachable from Docker via host.docker.internal on Linux/macOS.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# --- OpenAI (set LLM_PROVIDER=openai to use) --------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (set LLM_PROVIDER=anthropic to use) --------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ---------------------------------------------------------------------------
# Fault injection (simulator MCP server ONLY — local and test environments)
# ---------------------------------------------------------------------------

# NEVER set to true in production. Rules: rules.md §2.9 rule 9.
FAULTS_ENABLED=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Tool allow-list (read tools only; execute_operations is always excluded)
# ---------------------------------------------------------------------------

LLM_TOOL_ALLOWLIST=get_available_devices,list_parameters,get_telemetry_data,get_device_alarms,list_operations,get_sensor_history
